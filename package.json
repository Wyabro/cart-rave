    "compare": "node tools/compare.mjs",
    "blackframes": "node tools/blackframes.mjs",
    "tabhidden": "node tools/tabhidden.mjs",
    "netharness": "node tools/netharness.mjs",
    "gameharness": "node tools/gameharness.mjs",
    "battery": "node tools/battery.mjs",
    "dashboard": "node tools/refresh.mjs --offline",
    "playtest:console": "node tools/playtest-console.mjs",
    "refresh": "node tools/refresh.mjs",
    "cc": "npm run dashboard && node tools/open-cc.mjs",
    "status:size": "node tools/status-size.mjs",
