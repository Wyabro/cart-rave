{
  "name": "cart-clash",
  "private": true,
  "type": "module",
  "scriptsMeta": {
    "_doc": "Script guide — see docs/brand.md for naming. Worker host remains cart-rave until domain cutover.",
    "dev:local": "Vite + Wrangler local multiplayer (preferred)",
    "dev:party": "PartyServer local dev with wrangler"
  },
  "scripts": {
