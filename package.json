    "size:check": "node tools/bundle-budget.mjs",
    "size:update": "node tools/bundle-budget.mjs --write",
    "setup": "node tools/setup.mjs",
    "skills:sync": "node tools/skills-sync.mjs",
    "captures:pull": "node tools/pull-captures.mjs",
    "analytics:pull": "node tools/pull-analytics.mjs",
    "analytics": "node tools/pull-analytics.mjs",
    "perf:profile": "node tools/perf-profile.mjs"
