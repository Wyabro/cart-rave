{
  "permissions": {
    "allow": [
      "Bash(npm run qa)",
      "Bash(npm run qa *)",
      "PowerShell(npm run qa)",
      "PowerShell(npm run qa *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run typecheck *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "PowerShell(npm run test)",
      "PowerShell(npm run test *)",
      "Bash(npm run status:size)",
      "Bash(npm run status:size *)",
      "PowerShell(npm run status:size)",
      "PowerShell(npm run status:size *)",
      "Bash(npm run health:check)",
      "Bash(npm run health:check *)",
      "PowerShell(npm run health:check)",
      "PowerShell(npm run health:check *)",
      "Bash(npm run knip)",
      "Bash(npm run knip *)",
      "PowerShell(npm run knip)",
      "PowerShell(npm run knip *)",
      "Bash(npm run verify:head)",
      "Bash(npm run verify:head *)",
      "PowerShell(npm run verify:head)",
      "PowerShell(npm run verify:head *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "PowerShell(git fetch)",
      "PowerShell(git fetch *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-Process *)",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__computer",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__tabs_select",
      "mcp__Claude_Browser__tabs_close"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add -A*)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add ./)",
      "Bash(git add :/)",
      "Bash(git commit -a)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git commit --all)",
      "Bash(git commit --all *)",
      "PowerShell(git add -A)",
      "PowerShell(git add -A *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all)",
      "PowerShell(git add --all *)",
      "PowerShell(git add .)",
      "PowerShell(git add ./)",
      "PowerShell(git add :/)",
      "PowerShell(git commit -a)",
      "PowerShell(git commit -a *)",
      "PowerShell(git commit -am *)",
      "PowerShell(git commit --all)",
      "PowerShell(git commit --all *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|fork|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-briefing.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading Cart Clash briefing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-add.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git staging scope"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/track-session-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording session write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-stop-drift.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking HEAD before claiming done"
          }
        ]
      }
    ]
  }
}
