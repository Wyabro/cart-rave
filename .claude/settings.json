{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add -A*)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add ./)",
      "Bash(git add :/)",
      "Bash(git commit -a)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git commit --all)",
      "Bash(git commit --all *)",
      "PowerShell(git add -A)",
      "PowerShell(git add -A *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all)",
      "PowerShell(git add --all *)",
      "PowerShell(git add .)",
      "PowerShell(git add ./)",
      "PowerShell(git add :/)",
      "PowerShell(git commit -a)",
      "PowerShell(git commit -a *)",
      "PowerShell(git commit -am *)",
      "PowerShell(git commit --all)",
      "PowerShell(git commit --all *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|fork|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-briefing.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading Cart Clash briefing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-add.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git staging scope"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/track-session-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording session write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-stop-drift.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking HEAD before claiming done"
          }
        ]
      }
    ]
  }
}
