{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|fork|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-briefing.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading Cart Clash briefing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-add.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git staging scope"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ]
  }
}
