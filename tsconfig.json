{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src", "party", "shared"]
}
