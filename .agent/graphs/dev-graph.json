{
  "schema_version": 3,
  "name": "dev-plan-graph",
  "description": "Fail-closed DeepSeek maker, checker, and human acknowledgement flow.",
  "nodes": {
    "preflight": {
      "kind": "deterministic",
      "events": {
        "preflight_pass": "await_maker",
        "preflight_fail": "blocked"
      }
    },
    "await_maker": {
      "kind": "host",
      "events": {
        "maker_complete": "await_checker",
        "maker_fail": "blocked"
      }
    },
    "await_checker": {
      "kind": "host",
      "events": {
        "checker_approve": "await_ack",
        "checker_reject": "rejected",
        "checker_escalate": "escalated",
        "checker_fail": "blocked"
      }
    },
    "await_ack": {
      "kind": "human",
      "events": {
        "human_ack": "complete",
        "ack_fail": "blocked"
      }
    },
    "blocked": {
      "kind": "terminal",
      "events": {}
    },
    "rejected": {
      "kind": "terminal",
      "events": {}
    },
    "escalated": {
      "kind": "terminal",
      "events": {}
    },
    "complete": {
      "kind": "terminal",
      "events": {}
    }
  }
}
