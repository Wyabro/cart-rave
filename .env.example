# Copy to .env.local (dev) and .env.production.local (ship builds). Never commit real tokens.
# Runtime title token (installs / events) — safe for browser builds; still keep out of git.
VITE_GLITCH_TITLE_TOKEN=

# Deploy token is NOT a Vite var. Put it in this file (gitignored) so
# `npm run ship:glitch` survives a new shell. Mint once:
# glitch.fun → Developers Dashboard → Distribution → Cart Clash →
# Setup with AI → distribution token (starts with gl_deploy_).
# Do not reuse VITE_GLITCH_TITLE_TOKEN.
GLITCH_DEPLOY_TOKEN=
