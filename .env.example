# Copy to .env.local (dev) and .env.production.local (ship builds). Never commit real tokens.
# Runtime title token (installs / events) — safe for browser builds; still keep out of git.
VITE_GLITCH_TITLE_TOKEN=

# Deploy token is NOT a Vite var. Set only in your shell / CI when running:
#   $env:GLITCH_DEPLOY_TOKEN="gl_deploy_..."
#   npm run glitch:deploy
