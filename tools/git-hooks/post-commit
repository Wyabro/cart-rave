#!/bin/sh
# post-commit — refresh the LOCAL Command Center HTML after each commit.
# briefing + arch are already fresh from pre-commit, so this only rebuilds the
# gitignored .diag-captures/ surfaces: playtest-console + dashboard (the other
# two steps of tools/refresh.mjs would be redundant re-runs here).
# Installed via `npm run setup`. Non-fatal by design (it's a reporter).
[ -n "$SKIP_DOCS_HOOK" ] && exit 0
node tools/playtest-console.mjs >/dev/null 2>&1 || echo "[post-commit] playtest-console refresh failed (non-fatal)"
node tools/dashboard.mjs >/dev/null 2>&1 || echo "[post-commit] dashboard refresh failed (non-fatal)"
exit 0
