#!/bin/sh
# post-merge — refresh the gitignored playtest console after `git pull` / merge.
# Installed via `npm run setup` (core.hooksPath). Non-fatal.
# Escape hatch: SKIP_DOCS_HOOK=1
[ -n "$SKIP_DOCS_HOOK" ] && exit 0
node tools/playtest-console.mjs >/dev/null 2>&1 || echo "[post-merge] playtest-console refresh failed (non-fatal)"
exit 0
