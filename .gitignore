.DS_Store
Thumbs.db

# Env / deploy artifacts
.env
.env.local
.vercel/

# Logs
*.log

# Editor/IDE
.vscode/

# Cursor
.cursor/

# Node / Vite
node_modules/
dist/

# Visual QA screenshots (regenerate with npm run shoot)
shots/

# Diagnostic bug-capture bundles (JSON + screenshots from the harness rigs)
.diag-captures/

# PartyKit deploy staging (copied from dist/ during ship)
party-static/
# Wrangler local state
.wrangler/
# PartyKit local state
.partykit/
/assets/
/sounds/
index.html.partykit.bak

# Python
__pycache__/
*.pyc
.venv/

.tmp-gltf-imgs/

# Blender — ignore auto-backups + scratch working copies under art/, but keep the
# tracked master (cartrave4.blend). New scratch (*fucked.blend, *revise.blend, …)
# stays out of git without needing a rule each time.
*.blend[0-9]
/art/*.blend
!/art/cartrave4.blend
