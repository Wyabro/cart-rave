.DS_Store
Thumbs.db

# Env / deploy artifacts
.env
.env.local
.vercel/

# Logs
*.log

# Editor/IDE
.vscode/

# Cursor (local state stays ignored; shared rules are committed)
.cursor/*
!.cursor/rules/

# Node / Vite
node_modules/
dist/

# Visual QA screenshots (regenerate with npm run shoot)
shots/

# Diagnostic bug-capture bundles (JSON + screenshots from the harness rigs)
.diag-captures/

# Grok's local browser-automation scratch (not part of the toolchain)
tools/browser/

# PartyKit deploy staging (copied from dist/ during ship)
party-static/
# Wrangler local state
.wrangler/
# PartyKit local state
.partykit/
/assets/
/sounds/
index.html.partykit.bak

# Agent-skill symlinks. `npx skills add` installs the real files to
# .agents/skills/ (committed) and symlinks them here per agent tool. The link
# target is an ABSOLUTE machine path and core.symlinks=false on Windows, so git
# would store it as a text file containing C:\Users\... — useless anywhere else.
# Re-create it by re-running the installer after a fresh clone.
.claude/skills/

# Python
__pycache__/
*.pyc
.venv/

.tmp-gltf-imgs/

# Blender — ignore auto-backups + scratch working copies under art/, but keep the
# tracked master (cartrave4.blend). New scratch (*fucked.blend, *revise.blend, …)
# stays out of git without needing a rule each time.
*.blend[0-9]
/art/*.blend
!/art/cartrave4.blend
