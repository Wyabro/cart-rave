{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cart-rave",
  "main": "party/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CartRaveServer",
        "class_name": "CartRaveServer"
      },
      {
        "name": "ERROR_LOG",
        "class_name": "ErrorLog"
      },
      {
        "name": "ANALYTICS_LOG",
        "class_name": "AnalyticsLog"
      },
      {
        "name": "CAPTURE_LOG",
        "class_name": "CaptureLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CartRaveServer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ErrorLog"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AnalyticsLog"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["CaptureLog"]
    }
  ]
}
