{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cart-rave",
  "main": "party/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  // * Workers Logs — DO exceptions / console / request outcomes in the dashboard
  // * (paid plan; complements F8 CaptureLog + client analytics). 100% sample is fine
  // * at playtest traffic; dial head_sampling_rate down if log volume ever gets noisy.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  // * Public domain cutover: Custom Domains on the same Worker (not Pages/Vercel).
  // * Cloudflare creates DNS + certs on deploy. workers.dev stays staging.
  "routes": [
    { "pattern": "cartclash.lol", "custom_domain": true },
    { "pattern": "www.cartclash.lol", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CartRaveServer",
        "class_name": "CartRaveServer"
      },
      {
        "name": "ERROR_LOG",
        "class_name": "ErrorLog"
      },
      {
        "name": "ANALYTICS_LOG",
        "class_name": "AnalyticsLog"
      },
      {
        "name": "CAPTURE_LOG",
        "class_name": "CaptureLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CartRaveServer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ErrorLog"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AnalyticsLog"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["CaptureLog"]
    }
  ]
}
